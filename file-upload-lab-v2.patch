+<?php
+
+use Illuminate\Http\UploadedFile;
+use Illuminate\Support\Facades\Storage;
+
+function uploadLab(string $level, ?UploadedFile $file = null)
+{
+    return test()->post('/vulns/file-upload', array_filter([
+        'level' => $level,
+        'upload' => $file,
+    ]));
+}
+
+function labName(string $extension): string
+{
+    return 'labtest-' . uniqid() . '.' . $extension;
+}
+
+function labPng(string $name): UploadedFile
+{
+    // A real 1x1 PNG, so content-based detection recognises it.
+    $png = base64_decode('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==');
+
+    return UploadedFile::fake()->createWithContent($name, $png);
+}
+
+afterEach(function () {
+    foreach (glob(public_path('uploads/*/labtest-*')) ?: [] as $leftover) {
+        @unlink($leftover);
+    }
+});
+
+test('the file upload lab page loads', function () {
+    $this->get('/vulns/file-upload')->assertOk()->assertSee('Unrestricted File Upload Lab');
+});
+
+test('level 1 saves any file, including php, under its original name in public', function () {
+    $name = labName('php');
+    $file = UploadedFile::fake()->createWithContent($name, "<?php echo 6 * 7;\n");
+
+    uploadLab('level1', $file)
+        ->assertRedirect()
+        ->assertSessionHas('upload_result.ok', true);
+
+    expect(is_file(public_path('uploads/level1/' . $name)))->toBeTrue();
+});
+
+test('level 2 rejects a php file sent with its honest content type', function () {
+    $name = labName('php');
+    $file = UploadedFile::fake()->createWithContent($name, "<?php echo 6 * 7;\n");
+
+    uploadLab('level2', $file)->assertSessionHas('upload_result.ok', false);
+
+    expect(is_file(public_path('uploads/level2/' . $name)))->toBeFalse();
+});
+
+test('level 2 can be bypassed by lying about the content type', function () {
+    $name = labName('php');
+    $file = UploadedFile::fake()->create($name, 1, 'image/png');
+
+    uploadLab('level2', $file)->assertSessionHas('upload_result.ok', true);
+
+    expect(is_file(public_path('uploads/level2/' . $name)))->toBeTrue();
+});
+
+test('the secure level rejects scripts even when the content type is spoofed', function () {
+    Storage::fake('local');
+
+    $spoofedType = UploadedFile::fake()->create(labName('php'), 1, 'image/png');
+    $fakeImage = UploadedFile::fake()->createWithContent(labName('png'), "<?php echo 6 * 7;\n");
+
+    uploadLab('secure', $spoofedType)->assertSessionHas('upload_result.ok', false);
+    uploadLab('secure', $fakeImage)->assertSessionHas('upload_result.ok', false);
+
+    expect(Storage::disk('local')->allFiles('lab-uploads'))->toBeEmpty();
+});
+
+test('the secure level stores a real image under a random name outside public', function () {
+    Storage::fake('local');
+
+    $original = labName('png');
+
+    uploadLab('secure', labPng($original))
+        ->assertSessionHas('upload_result.ok', true)
+        ->assertSessionHas('upload_result.url', null);
+
+    $stored = session('upload_result.name');
+
+    expect($stored)->not->toBe($original)->and($stored)->toEndWith('.png');
+    Storage::disk('local')->assertExists('lab-uploads/' . $stored);
+});
+
+test('a request without a file is reported as a failure', function () {
+    uploadLab('level1')->assertSessionHas('upload_result.ok', false);
+});
+
+test('an unknown level is rejected', function () {
+    uploadLab('nope', labPng(labName('png')))->assertStatus(400);
+});
